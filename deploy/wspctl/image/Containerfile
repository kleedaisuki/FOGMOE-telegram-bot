# syntax=docker/dockerfile:1

# @brief wspctl runtime 的唯一标准构建定义 / Sole standard build definition for the wspctl runtime.
#
# Builder 与 runtime 固定到同一个 OCI manifest digest，避免把 host ABI 带入镜像。
# The builder and runtime are pinned to the same OCI manifest digest so no host ABI enters
# the image. Debian package resolution is separately fixed to a snapshot timestamp.
ARG PYTHON_BASE=docker.io/library/python:3.14-slim-bookworm@sha256:86f975aca15cf04a40b399eebede9aea7c82eae084d1f1a0a6ef6bcaae871a30
ARG DEBIAN_SNAPSHOT=20260728T000000Z
ARG WSPCTL_AGENT_UID=65533
ARG WSPCTL_AGENT_GID=65533

FROM ${PYTHON_BASE} AS supervisor-builder

ARG DEBIAN_SNAPSHOT
ENV PYTHONDONTWRITEBYTECODE=1

RUN printf '%s\n' \
      "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main" \
      "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main" \
      > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=10 -o Acquire::https::Timeout=60 update \
    && apt-get -o Acquire::Retries=10 -o Acquire::https::Timeout=60 \
      install --yes --no-install-recommends \
      build-essential \
      libcap-dev \
      libseccomp-dev \
      libssl-dev \
      pkg-config \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/*

COPY --from=wspctl-build-tools / /build-tools

RUN python -m pip install \
      --no-index \
      --no-deps \
      /build-tools/cmake-4.3.2-py3-none-manylinux2014_x86_64.manylinux_2_17_x86_64.whl \
      /build-tools/ninja-1.13.0-py3-none-manylinux2014_x86_64.manylinux_2_17_x86_64.whl \
    && rm -rf /build-tools

WORKDIR /source
COPY CMakeLists.txt ./
COPY src/wspctl ./src/wspctl

RUN cmake \
      -S . \
      -B /build \
      -G Ninja \
      -DBUILD_TESTING=OFF \
      -DWSPCTL_BUILD_PYTHON_BINDINGS=OFF \
      -DWSPCTL_INSTALL_HOST_TOOLS=OFF \
      -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build --target wsp-systemd \
    && install \
      --directory \
      --owner=root \
      --group=root \
      --mode=0755 \
      /output/usr/local/libexec/wspctl \
    && install \
      --owner=root \
      --group=root \
      --mode=0755 \
      /build/src/wspctl/wsp-systemd \
      /output/usr/local/libexec/wspctl/wsp-systemd


FROM ${PYTHON_BASE} AS wspctl-runtime

ARG DEBIAN_SNAPSHOT
ARG WSPCTL_AGENT_UID
ARG WSPCTL_AGENT_GID
LABEL org.opencontainers.image.title="FogMoe wspctl workspace runtime" \
      org.opencontainers.image.source="https://github.com/FogMoe/FOGMOE-telegram-bot" \
      org.opencontainers.image.version="wspctl-runtime-v3" \
      io.fogmoe.wspctl.contract="3"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN printf '%s\n' \
      "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main" \
      "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main" \
      > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=10 -o Acquire::https::Timeout=60 update \
    && apt-get -o Acquire::Retries=10 -o Acquire::https::Timeout=60 \
      install --yes --no-install-recommends \
      bash \
      build-essential \
      ca-certificates \
      coreutils \
      curl \
      diffutils \
      ffmpeg \
      file \
      findutils \
      git \
      grep \
      htop \
      imagemagick \
      jq \
      libcap2 \
      libseccomp2 \
      libssl3 \
      neofetch \
      openjdk-17-jdk-headless \
      patch \
      procps \
      ripgrep \
      sed \
      sqlite3 \
      tree \
      unzip \
      wget \
      xz-utils \
      zip \
    && find /bin /etc /lib /opt /run /sbin /usr /var \
      -xdev \( ! -uid 0 -o ! -gid 0 \) \
      -exec chown --no-dereference root:root '{}' + \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/*

COPY --from=wspctl-build-tools / /runtime-tools

RUN install --directory --owner=root --group=root --mode=0755 \
      /usr/local/lib/node_modules/pnpm \
    && tar --extract --xz \
      --file /runtime-tools/node-v24.18.1-linux-x64.tar.xz \
      --directory /usr/local \
      --no-same-owner \
      --strip-components=1 \
    && tar --extract --gzip \
      --file /runtime-tools/pnpm-11.18.0.tgz \
      --directory /usr/local/lib/node_modules/pnpm \
      --no-same-owner \
      --strip-components=1 \
    && ln -s ../lib/node_modules/pnpm/bin/pnpm.mjs /usr/local/bin/pnpm \
    && ln -s ../lib/node_modules/pnpm/bin/pnpx.mjs /usr/local/bin/pnpx \
    && rm -rf /runtime-tools

RUN find /usr/local/lib/python3.14/site-packages \
      -mindepth 1 \
      -delete \
    && ! getent passwd "$WSPCTL_AGENT_UID" >/dev/null \
    && ! getent group "$WSPCTL_AGENT_GID" >/dev/null \
    && ! getent passwd agent >/dev/null \
    && ! getent group agent >/dev/null \
    && printf 'agent:x:%s:\n' "$WSPCTL_AGENT_GID" >> /etc/group \
    && printf 'agent:x:%s:%s:Workspace Agent:/workspace:/bin/bash\n' \
      "$WSPCTL_AGENT_UID" "$WSPCTL_AGENT_GID" >> /etc/passwd \
    && install --directory --owner=root --group=root --mode=0755 \
      /run /usr/local/libexec/wspctl /workspace \
    && install --directory --owner=root --group=root --mode=1777 /tmp \
    && rm -rf /var/tmp \
    && ln -s /tmp /var/tmp

COPY --from=supervisor-builder \
  /output/usr/local/libexec/wspctl/wsp-systemd \
  /usr/local/libexec/wspctl/wsp-systemd

RUN test -z "$(find \
      /bin /etc /lib /opt /run /sbin /usr /var /workspace \
      -xdev \( ! -uid 0 -o ! -gid 0 \) -print -quit)" \
    && find / -xdev -type f -perm /6000 -exec chmod a-s '{}' + \
    && chmod 1777 /tmp \
    && chmod 0755 /workspace \
    && python -I -S -c \
      "import ctypes, json, sqlite3, ssl; assert __import__('sys').version_info[:2] == (3, 14)" \
    && test "$(id -u agent)" = "$WSPCTL_AGENT_UID" \
    && test "$(id -g agent)" = "$WSPCTL_AGENT_GID" \
    && test -x /bin/bash \
    && test -x /usr/bin/ls \
    && test -x /usr/bin/curl \
    && test -x /usr/bin/wget \
    && test -x /usr/bin/git \
    && test -x /usr/bin/jq \
    && test -x /usr/bin/gcc \
    && test -x /usr/bin/g++ \
    && test -x /usr/bin/ffmpeg \
    && test -x /usr/bin/convert \
    && test -x /usr/bin/sqlite3 \
    && test -x /usr/bin/htop \
    && test -x /usr/bin/tree \
    && test -x /usr/bin/neofetch \
    && test -x /usr/bin/java \
    && test -x /usr/bin/javac \
    && test -x /usr/local/bin/node \
    && test -x /usr/local/bin/npm \
    && test -x /usr/local/bin/pnpm \
    && test -x /usr/local/bin/python3 \
    && test "$(node --version)" = "v24.18.1" \
    && test "$(pnpm --version)" = "11.18.0" \
    && test -x /usr/local/libexec/wspctl/wsp-systemd \
    && ! ldd /usr/local/bin/python | grep 'not found' \
    && ! ldd /usr/local/libexec/wspctl/wsp-systemd | grep 'not found'

ENTRYPOINT ["/usr/local/libexec/wspctl/wsp-systemd"]

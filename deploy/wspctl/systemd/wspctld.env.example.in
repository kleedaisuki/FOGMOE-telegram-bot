# @brief wspctld root-owned host 配置示例模板 / Root-owned host configuration example template for wspctld.
#
# CMake 已将 WSPCTL_HOST_WORKDIR 的绝对值写入此文件。默认的仓库 .wspctl 只适用于
# local development，且必须随 -DWSPCTL_ALLOW_INSECURE_DEVELOPMENT_ROOT=ON 显式承认
# checkout owner 是 trusted control plane；生产必须以
# -DWSPCTL_HOST_WORKDIR=/an/absolute/root-owned/path 重新生成。
# Install as @WSPCTL_HOST_ENVIRONMENT_PATH@ with owner root:root and mode 0600. The image
# builder must publish a root-owned immutable OCI image through a distinct readonly mount
# before this service starts; directory permissions alone do not satisfy the verifier.

WSPCTL_SOCKET=@WSPCTL_HOST_SOCKET_PATH@
# Operator inspection uses an entirely separate endpoint. Do not bind mount this path into the
# Bot container and do not set it to WSPCTL_CLIENT_UID: the native broker rejects matching UIDs.
WSPCTL_OPERATOR_SOCKET=@WSPCTL_HOST_OPERATOR_SOCKET_PATH@
# Root is the production and development default. Invoke `/usr/local/bin/wspctl` through sudo;
# changing this requires a separately trusted local operator UID, never the Bot UID.
WSPCTL_OPERATOR_UID=0
# This is an existing dedicated XFS mount with rw,prjquota (or rw,pquota).  It is intentionally
# the state root itself: images live at @WSPCTL_HOST_IMAGES_ROOT@ on a different filesystem.
# Never use pqnoenforce; wspctld verifies kernel project accounting + enforcement again.
WSPCTL_STATE_ROOT=@WSPCTL_HOST_STATE_ROOT@
WSPCTL_XFS_QUOTA_MOUNT=@WSPCTL_HOST_STATE_ROOT@
WSPCTL_QUOTA_BACKEND=xfs_project_v1
# Inclusive, nonzero project-ID range: first ID even, final ID odd, no automatic reuse.
WSPCTL_XFS_PROJECT_ID_MIN=100000
WSPCTL_XFS_PROJECT_ID_MAX=199999
# Both byte limits must be exact multiples of 512 because the XFS quota ABI uses 512-byte blocks.
WSPCTL_RUNTIME_CONTROL_HARD_BYTES=16777216
WSPCTL_RUNTIME_CONTROL_HARD_INODES=8192
WSPCTL_RUNTIME_WORKSPACE_HARD_BYTES=1073741824
WSPCTL_RUNTIME_WORKSPACE_HARD_INODES=131072
# Admission counts every ready, allocating, and quarantined pair; leave filesystem recovery headroom.
WSPCTL_XFS_GLOBAL_ADMISSION_BYTES=53687091200
WSPCTL_XFS_GLOBAL_ADMISSION_INODES=6291456
WSPCTL_XFS_SYSTEM_RESERVE_BYTES=4294967296
WSPCTL_XFS_SYSTEM_RESERVE_INODES=262144
WSPCTL_IMAGES_ROOT=@WSPCTL_HOST_IMAGES_ROOT@
# 权威 identity；broker 只接受 sha256 digest，不接受 tag 或任意 generation 名。/
# Authoritative identity; the broker accepts only a sha256 digest, never a tag or arbitrary generation.
WSPCTL_IMAGE_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX
WSPCTL_CGROUP_ROOT=/sys/fs/cgroup/system.slice/wspctld.service
WSPCTL_CLIENT_UID=65532
WSPCTL_SANDBOX_UID=65534
WSPCTL_SANDBOX_GID=65534
WSPCTL_MEMORY_MAX=536870912
# 在超出此阈值时先回收/节流；不得高于 memory.max。
# Reclaim/throttle begins at this threshold; it must not exceed memory.max.
WSPCTL_MEMORY_HIGH=536870912
# 默认不允许 runtime 将匿名内存转入 swap。
# Runtime anonymous memory is not allowed to enter swap by default.
WSPCTL_MEMORY_SWAP_MAX=0
# 50 ms per 100 ms period: at most half of one CPU for each runtime cgroup.
WSPCTL_CPU_MAX_US=50000
WSPCTL_CPU_PERIOD_US=100000
WSPCTL_PIDS_MAX=128
# cgroup v2 relative I/O weight（1..10000）；0 在 host 不提供 io.weight 时禁用此 QoS。
# 它不是全局磁盘容量配额；容量仍由 XFS project quota 强制。/
# cgroup v2 relative I/O weight (1..10000); zero disables this QoS when the host does not
# expose io.weight. It is not a disk-capacity quota; XFS project quota remains enforced.
WSPCTL_IO_WEIGHT=100
WSPCTL_IDLE_MINUTES=15
